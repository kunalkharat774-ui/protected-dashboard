{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/index.ts": {
      "excludeFiles": "**/.env*"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path(.*)",
      "destination": "/api?__vercel_api_path=:path"
    },
    {
      "source": "/((?!api/|project-info\\.html$|robots\\.txt$|sitemap\\.xml$).*)",
      "destination": "/index.html"
    }
  ]
}
