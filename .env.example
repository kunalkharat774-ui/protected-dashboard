# Google Maps Platform key for the browser map. Restrict it to the Maps JavaScript API
# and your local/deployed website origins. This key is included in the browser bundle.
VITE_GOOGLE_MAPS_API_KEY=

# Optional server-side isMalicious API key for URL reputation lookups.
ISMALICIOUS_API_KEY=

# Supabase server-side storage for consented, coarse device visit records.
# Use the project URL and a server-side Supabase secret key; never use VITE_ or NEXT_PUBLIC_ for this key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Local fallback path when Supabase is not configured. Defaults to ./data/device-visits.json.
# DEVICE_INTELLIGENCE_STORAGE_PATH="C:\\securewatch-data\\device-visits.json"
